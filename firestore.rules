rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public Access Log collection
    match /logbook/{entryId} {
      // 1. Allow reading so the public feed displays signers
      allow read: if true;
      
      // 2. Allow anyone to create new entries with strict validation
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.trim().size() > 0 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.keys().hasOnly(['name', 'timestamp']);
                    
      // 3. Prevent any modifying or deleting of existing log entries
      allow update: if false;
      allow delete: if false;
    }

    // Tasks collection: Strictly locked to the logged-in user's own tasks
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Private Workspace data: STRICTLY LOCKED to authenticated owner accounts
    match /workspace/{docId} {
      allow read, write: if request.auth != null;
    }

    match /private/{docId} {
      allow read, write: if request.auth != null;
    }

    // Block all access to any other collections across the database
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
