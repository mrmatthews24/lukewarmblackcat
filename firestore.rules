rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Logbook entries collection
    match /logbook/{entryId} {
      // Allow reading so the app's display feed can load and render signers
      allow read: if true;
      
      // Allow creation of new logbook entries with strict field validation
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.trim().size() > 0 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.keys().hasOnly(['name', 'timestamp']);
                    
      // Strictly prevent editing, modifying, or deleting existing entries
      allow update: if false;
      allow delete: if false;
    }

    // Block all access to any other collections and documents in the entire database
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
